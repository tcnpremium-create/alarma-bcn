{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "redirects": [
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "www.alarmasenbarcelona.com" }],
      "destination": "https://alarmasenbarcelona.com/$1",
      "permanent": true
    },
    {
      "source": "/videovigilancia",
      "destination": "/camaras-barcelona",
      "permanent": true
    },
    {
      "source": "/Videovigilancia",
      "destination": "/camaras-barcelona",
      "permanent": true
    },
    {
      "source": "/sistemas-alarma",
      "destination": "/alarmas-barcelona",
      "permanent": true
    },
    {
      "source": "/SistemasAlarma",
      "destination": "/alarmas-barcelona",
      "permanent": true
    },
    {
      "source": "/sin-cuotas-mensuales",
      "destination": "/alarmas-barcelona",
      "permanent": true
    },
    {
      "source": "/comparativa-verisure",
      "destination": "/alarmas-barcelona",
      "permanent": true
    },
    {
      "source": "/alarmas-sin-permanencia",
      "destination": "/alarmas-barcelona",
      "permanent": true
    },
    {
      "source": "/Girona",
      "destination": "/alarmas-girona",
      "permanent": true
    },
    {
      "source": "/Sabadell",
      "destination": "/alarmas-sabadell",
      "permanent": true
    },
    {
      "source": "/Tarragona",
      "destination": "/alarmas-tarragona",
      "permanent": true
    },
    {
      "source": "/Lleida",
      "destination": "/alarmas-lleida",
      "permanent": true
    }
  ],
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/$1" },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Access-Control-Allow-Methods", "value": "GET,POST,PATCH,OPTIONS" },
        { "key": "Access-Control-Allow-Headers", "value": "Content-Type" }
      ]
    }
  ],
  "crons": [
    { "path": "/api/cron/keepalive", "schedule": "0 6 * * *" }
  ]
}
